\item \code{\link[=bridge_logml]{bridge_logml()}} -- the estimate alone (safeguarded Newton on the log scale).
\item \code{\link[=bridge_sampler_cmdstanr]{bridge_sampler_cmdstanr()}} -- run \code{bridgesampling} on a \code{cmdstanr} fit.
\item \code{\link[=bridge_crossfit]{bridge_crossfit()}} -- two-fold cross-fitted bridge sampling.
}
}
